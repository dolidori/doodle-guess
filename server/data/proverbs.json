{
  "$schema_note": "그림으로 표현하는 속담 모음. 정답 판정이 완전 일치라 기본 제시어와 섞어 쓰면 라운드가 막힐 수 있어 별도 파일로 보관한다. 현재 게임에는 사용하지 않는다.",
  "version": 1,
  "words": [
    {
      "id": 1,
      "text": "가는 말이 고와야 오는 말이 곱다",
      "category": "속담"
    },
    {
      "id": 2,
      "text": "가는 날이 장날이다",
      "category": "속담"
    },
    {
      "id": 3,
      "text": "가지 많은 나무에 바람 잘 날 없다",
      "category": "속담"
    },
    {
      "id": 4,
      "text": "강 건너 불구경",
      "category": "속담"
    },
    {
      "id": 5,
      "text": "개구리 올챙이 적 생각 못 한다",
      "category": "속담"
    },
    {
      "id": 6,
      "text": "개천에서 용 난다",
      "category": "속담"
    },
    {
      "id": 7,
      "text": "고생 끝에 낙이 온다",
      "category": "속담"
    },
    {
      "id": 8,
      "text": "공든 탑이 무너지랴",
      "category": "속담"
    },
    {
      "id": 9,
      "text": "구르는 돌은 이끼가 끼지 않는다",
      "category": "속담"
    },
    {
      "id": 10,
      "text": "김칫국부터 마신다",
      "category": "속담"
    },
    {
      "id": 11,
      "text": "낮말은 새가 듣고 밤말은 쥐가 듣는다",
      "category": "속담"
    },
    {
      "id": 12,
      "text": "내 코가 석 자",
      "category": "속담"
    },
    {
      "id": 13,
      "text": "누워서 떡 먹기",
      "category": "속담"
    },
    {
      "id": 14,
      "text": "누워서 침 뱉기",
      "category": "속담"
    },
    {
      "id": 15,
      "text": "닭 잡아먹고 오리발 내민다",
      "category": "속담"
    },
    {
      "id": 16,
      "text": "도둑이 제 발 저리다",
      "category": "속담"
    },
    {
      "id": 17,
      "text": "돌다리도 두들겨 보고 건너라",
      "category": "속담"
    },
    {
      "id": 18,
      "text": "등잔 밑이 어둡다",
      "category": "속담"
    },
    {
      "id": 19,
      "text": "말 한마디로 천 냥 빚을 갚는다",
      "category": "속담"
    },
    {
      "id": 20,
      "text": "모르는 것이 약",
      "category": "속담"
    },
    {
      "id": 21,
      "text": "믿는 도끼에 발등 찍힌다",
      "category": "속담"
    },
    {
      "id": 22,
      "text": "밑 빠진 독에 물 붓기",
      "category": "속담"
    },
    {
      "id": 23,
      "text": "바늘 도둑이 소 도둑 된다",
      "category": "속담"
    },
    {
      "id": 24,
      "text": "발 없는 말이 천 리 간다",
      "category": "속담"
    },
    {
      "id": 25,
      "text": "배보다 배꼽이 더 크다",
      "category": "속담"
    },
    {
      "id": 26,
      "text": "백지장도 맞들면 낫다",
      "category": "속담"
    },
    {
      "id": 27,
      "text": "빈 수레가 요란하다",
      "category": "속담"
    },
    {
      "id": 28,
      "text": "세 살 버릇 여든까지 간다",
      "category": "속담"
    },
    {
      "id": 29,
      "text": "소 잃고 외양간 고친다",
      "category": "속담"
    },
    {
      "id": 30,
      "text": "시작이 반이다",
      "category": "속담"
    },
    {
      "id": 31,
      "text": "아는 길도 물어 가라",
      "category": "속담"
    },
    {
      "id": 32,
      "text": "열 번 찍어 안 넘어가는 나무 없다",
      "category": "속담"
    },
    {
      "id": 33,
      "text": "옷이 날개다",
      "category": "속담"
    },
    {
      "id": 34,
      "text": "우물 안 개구리",
      "category": "속담"
    },
    {
      "id": 35,
      "text": "윗물이 맑아야 아랫물이 맑다",
      "category": "속담"
    },
    {
      "id": 36,
      "text": "쥐구멍에도 볕들 날 있다",
      "category": "속담"
    },
    {
      "id": 37,
      "text": "천 리 길도 한 걸음부터",
      "category": "속담"
    },
    {
      "id": 38,
      "text": "찬물도 위아래가 있다",
      "category": "속담"
    },
    {
      "id": 39,
      "text": "티끌 모아 태산",
      "category": "속담"
    },
    {
      "id": 40,
      "text": "콩 심은 데 콩 나고 팥 심은 데 팥 난다",
      "category": "속담"
    },
    {
      "id": 41,
      "text": "하늘이 무너져도 솟아날 구멍은 있다",
      "category": "속담"
    },
    {
      "id": 42,
      "text": "한 번 엎지른 물은 다시 담을 수 없다",
      "category": "속담"
    },
    {
      "id": 43,
      "text": "호랑이도 제 말하면 온다",
      "category": "속담"
    },
    {
      "id": 44,
      "text": "낙숫물이 댓돌을 뚫는다",
      "category": "속담"
    },
    {
      "id": 45,
      "text": "될성부른 나무는 떡잎부터 알아본다",
      "category": "속담"
    },
    {
      "id": 46,
      "text": "매도 먼저 맞는 것이 낫다",
      "category": "속담"
    },
    {
      "id": 47,
      "text": "보기 좋은 떡이 먹기 좋다",
      "category": "속담"
    },
    {
      "id": 48,
      "text": "비 온 뒤에 땅이 굳어진다",
      "category": "속담"
    },
    {
      "id": 49,
      "text": "쇠뿔도 단김에 빼랬다",
      "category": "속담"
    },
    {
      "id": 50,
      "text": "식은 죽 먹기",
      "category": "속담"
    },
    {
      "id": 51,
      "text": "싼 것이 비지떡",
      "category": "속담"
    },
    {
      "id": 52,
      "text": "이웃 사촌",
      "category": "속담"
    },
    {
      "id": 53,
      "text": "작은 고추가 더 맵다",
      "category": "속담"
    },
    {
      "id": 54,
      "text": "가슴이 철렁하다",
      "category": "속담"
    },
    {
      "id": 55,
      "text": "벼는 익을수록 고개를 숙인다",
      "category": "속담"
    },
    {
      "id": 56,
      "text": "구더기 무서워하다 장 못 담근다",
      "category": "속담"
    },
    {
      "id": 57,
      "text": "그림의 떡",
      "category": "속담"
    }
  ]
}
