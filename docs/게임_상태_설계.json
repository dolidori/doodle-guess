  "xStateCorrespondence": [
    {
      "roomStatus": "WAITING",
      "roundStatus": "PREPARING_KEYWORD"
    },
    {
      "roomStatus": "ROUND_ACTIVE",
      "roundStatus": "DRAWING_AND_GUESSING"
    },
    {
      "roomStatus": "ROUND_SOLVED",
      "roundStatus": "SOLVED"
    },
    {
      "roomStatus": "ROUND_EXPIRED",
      "roundStatus": "EXPIRED"
    }
  ],
  "xStateTransitions": [
    {
      "from": "WAITING/PREPARING_KEYWORD",
      "action": "SET_KEYWORD_AND_START",
      "actor": "drawerId",
      "guard": "drawer connected, eligible connected guesser >= 1, keyword valid",
      "atomicEffects": "keyword and normalizedKeyword stored; drawer and moderator added to keywordExposedPlayerIds; startedAt set; roundEndsAt=startedAt+durationSeconds*1000; guessLocked=false; drawingLocked=false; statuses become ROUND_ACTIVE/DRAWING_AND_GUESSING"
    },
    {
      "from": "ROUND_ACTIVE/DRAWING_AND_GUESSING",
      "action": "first accepted correct guess",
      "actor": "eligible guesser",
      "guard": "serverNow < roundEndsAt and status still active",
      "atomicEffects": "Guess appended and shared; winner stored once; solvedAt set; lastRoundEventId set; guessLocked=true; drawingLocked=true; statuses become ROUND_SOLVED/SOLVED"
    },
    {
      "from": "ROUND_ACTIVE/DRAWING_AND_GUESSING",
      "action": "deadline",
      "actor": "server room queue",
      "guard": "serverNow >= roundEndsAt and status still active",
      "atomicEffects": "winner remains null; expiredAt set; lastRoundEventId set; guessLocked=true; drawingLocked=true; statuses become ROUND_EXPIRED/EXPIRED"
    },
    {
      "from": "ROUND_SOLVED/SOLVED",
      "action": "START_NEXT_ROUND",
      "actor": "NORMAL host or MODERATOR moderator",
      "guard": "actor connected",
      "atomicEffects": "new roundId and roundNumber; keyword, winner, keywordExposedPlayerIds and guessFeed cleared; drawingRevision incremented; drawingSeq reset; drawerId and durationSeconds retained; statuses become WAITING/PREPARING_KEYWORD"
    },
    {
      "from": "ROUND_EXPIRED/EXPIRED",
      "action": "START_NEXT_ROUND",
      "actor": "NORMAL host or MODERATOR moderator",
      "guard": "actor connected",
      "atomicEffects": "same reset as solved next round"
    },
    {
      "from": "any non-CLOSED",
      "action": "host disconnect",
      "actor": "connection lifecycle",
      "guard": "playerId equals immutable hostId",
      "atomicEffects": "connected=false; isHost and hostId retained; hostDisconnectedAt set; expiresAt=hostDisconnectedAt+1800000; no host transfer"
    },
    {
      "from": "any non-CLOSED",
      "action": "host reconnect before expiresAt",
      "actor": "session token or exact nickname fallback",
      "guard": "existing host slot disconnected and not expired",
      "atomicEffects": "same host slot connected; token rotated; hostDisconnectedAt and expiresAt cleared; no role mutation"
    },
    {
      "from": "any non-CLOSED",
      "action": "host TTL expiry",
      "actor": "server room queue",
      "guard": "host still disconnected and serverNow >= expiresAt",
      "atomicEffects": "status=CLOSED; ROOM_CLOSED broadcast; all connections closed; room removed"
    },
    {
      "from": "MODERATOR room in PREPARING_KEYWORD or DRAWING_AND_GUESSING",
      "action": "KICK_PLAYER targeting drawerId",
      "actor": "host or moderator",
      "guard": "target is a non-privileged same-room player",
      "atomicEffects": "target removed and blocked; drawerId=moderatorId; drawerEpoch incremented; KICKED sent to target; PLAYER_KICKED and PUBLIC_STATE sent to remaining room"
    }
  ],
  "xAllowedActionRules": [
    {
      "action": "LEAVE_ROOM",
      "when": "actor is a connected room member and room.status is not CLOSED"
    },
    {
      "action": "SET_ROUND_DURATION",
      "when": "round.status=PREPARING_KEYWORD and actor is host or moderator"
    },
    {
      "action": "SET_KEYWORD_AND_START",
      "when": "round.status=PREPARING_KEYWORD and actor.playerId=drawerId and minimum start condition holds"
    },
    {
      "action": "SUBMIT_GUESS",
      "when": "round.status=DRAWING_AND_GUESSING, serverNow<roundEndsAt, actor connected, actor not moderator, actor.playerId not in keywordExposedPlayerIds"
    },
    {
      "action": "DRAW_STROKE_BATCH",
      "when": "round.status=DRAWING_AND_GUESSING, serverNow<roundEndsAt, drawingLocked=false, actor.playerId=drawerId"
    },
    {
      "action": "UNDO_LAST_STROKE",
      "when": "DRAW_STROKE_BATCH condition and visibleStrokeIds is not empty"
    },
    {
      "action": "CLEAR_DRAWING",
      "when": "DRAW_STROKE_BATCH condition"
    },
    {
      "action": "ASSIGN_DRAWER",
      "when": "mode=MODERATOR, round.status in [PREPARING_KEYWORD, DRAWING_AND_GUESSING], actor is connected moderator, target is connected same-room player"
    },
    {
      "action": "RECLAIM_DRAWER",
      "when": "mode=MODERATOR, round.status in [PREPARING_KEYWORD, DRAWING_AND_GUESSING], actor is connected moderator, actor.playerId != drawerId"
    },
    {
      "action": "KICK_PLAYER",
      "when": "actor is connected host or moderator, target is different non-privileged same-room player"
    },
    {
      "action": "START_NEXT_ROUND",
      "when": "round.status in [SOLVED, EXPIRED] and actor is NORMAL host or MODERATOR moderator"
    }
  ],
  "xInvariants": [
    "A connection can read and mutate only its authenticated room.",
    "hostId is immutable for the room lifetime; host disconnect never transfers host authority.",
    "The player whose playerId equals hostId always retains isHost=true until room deletion.",
    "An active room has exactly one drawerId and only that player can mutate the drawing or set the keyword.",
    "keyword and normalizedKeyword never appear in PublicState, logs, errors, drawing snapshots, or other rooms.",
    "Only the current drawer and moderator receive keyword in PrivateState.",
    "Once a playerId enters keywordExposedPlayerIds, it stays there for that round and cannot submit guesses.",
    "Only server-accepted guesses enter guessFeed; every accepted guess is shared to the entire room in guessSeq order.",
    "Exactly one of SOLVED or EXPIRED terminates an active round.",
    "SOLVED and EXPIRED both lock drawing and guessing on server and client.",
    "durationSeconds is 20..180, divisible by 5, defaults to 60, and cannot change while active.",
    "roundEndsAt is set atomically with keyword acceptance and active transition.",
    "At or after roundEndsAt, request handling first commits expiry before evaluating drawing or guess mutation.",
    "Drawing authority is normalized vector strokes; repeated full-canvas bitmap frames are forbidden.",
    "Every stroke batch is validated against current roundId, drawingRevision, drawerEpoch, limits, and authenticated drawer.",
    "players.length includes host, moderator, and disconnected slots and never exceeds 30.",
    "When host is disconnected, expiresAt equals hostDisconnectedAt plus 1800000 milliseconds and no other player becomes host."
  ],
  "xProtocolBindings": {
    "clearDrawingCommand": "CLEAR_DRAWING",
    "clearDrawingBroadcast": "DRAWING_CLEARED",
    "nextRoundCommand": "START_NEXT_ROUND",
    "kickedTargetEvent": "KICKED",
    "kickedRoomEvent": "PLAYER_KICKED"
  },
  "xPersistence": {
    "type": "EPHEMERAL_IN_MEMORY",
    "restoreAfterServerRestart": false
  }
